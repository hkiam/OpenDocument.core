<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:loext="urn:org:documentfoundation:names:experimental:office:xmlns:loext:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.graphics">
 <office:styles>
  <draw:gradient draw:name="G" draw:style="linear" draw:start-color="#ff0000" draw:end-color="#0000ff" draw:angle="0deg"/>
  <draw:hatch draw:name="H" draw:style="single" draw:color="#3465a4" draw:distance="0.2cm" draw:rotation="450"/>
  <style:style style:name="base" style:family="graphic"><style:graphic-properties draw:stroke="solid" svg:stroke-color="#000000" svg:stroke-width="0.03cm" draw:shadow="visible" draw:shadow-offset-x="0.3cm" draw:shadow-offset-y="0.3cm" draw:shadow-color="#000000" draw:shadow-opacity="50%" loext:shadow-blur="0.15cm" draw:textarea-vertical-align="middle"/><style:paragraph-properties fo:text-align="center"/><style:text-properties fo:font-size="20pt" fo:font-family="'Liberation Sans'"/></style:style>
  <style:style style:name="solid" style:family="graphic" style:parent-style-name="base"><style:graphic-properties draw:fill="solid" draw:fill-color="#729fcf"/></style:style>
  <style:style style:name="grad" style:family="graphic" style:parent-style-name="base"><style:graphic-properties draw:fill="gradient" draw:fill-gradient-name="G"/></style:style>
  <style:style style:name="hatch" style:family="graphic" style:parent-style-name="base"><style:graphic-properties draw:fill="hatch" draw:fill-hatch-name="H"/></style:style>
  <style:style style:name="outline" style:family="graphic" style:parent-style-name="base"><style:graphic-properties draw:fill="none" svg:stroke-width="0.1cm" svg:stroke-color="#c9211e"/></style:style>
  <style:style style:name="line" style:family="graphic" style:parent-style-name="base"><style:graphic-properties svg:stroke-width="0.15cm" svg:stroke-color="#2a6099"/></style:style>
  <style:style style:name="boxfill" style:family="graphic" style:parent-style-name="base"><style:graphic-properties draw:fill="solid" draw:fill-color="#ffff99" draw:stroke="none"/></style:style>
  <style:style style:name="boxnone" style:family="graphic" style:parent-style-name="base"><style:graphic-properties draw:fill="none" draw:stroke="none"/></style:style>
  <style:style style:name="boxhatch" style:family="graphic" style:parent-style-name="base"><style:graphic-properties draw:fill="hatch" draw:fill-hatch-name="H" draw:stroke="none"/></style:style>
  <style:style style:name="group" style:family="graphic" style:parent-style-name="base"/>
  <style:style style:name="plain" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#77bc65" draw:stroke="none" draw:shadow="hidden"/></style:style>
 </office:styles>
 <office:automatic-styles>
  <style:page-layout style:name="PM"><style:page-layout-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:margin-left="0cm" fo:margin-right="0cm" fo:page-width="22cm" fo:page-height="14cm"/></style:page-layout>
 </office:automatic-styles>
 <office:master-styles><style:master-page style:name="M" style:page-layout-name="PM"/></office:master-styles>
 <office:body><office:drawing><draw:page draw:name="p" draw:master-page-name="M">
  <draw:rect draw:style-name="solid" svg:x="1cm" svg:y="1cm" svg:width="4cm" svg:height="3cm"/>
  <draw:rect draw:style-name="grad" svg:x="6cm" svg:y="1cm" svg:width="4cm" svg:height="3cm"/>
  <draw:rect draw:style-name="hatch" svg:x="11cm" svg:y="1cm" svg:width="4cm" svg:height="3cm"/>
  <draw:rect draw:style-name="outline" svg:x="16cm" svg:y="1cm" svg:width="4cm" svg:height="3cm"/>
  <draw:ellipse draw:style-name="solid" svg:x="1cm" svg:y="5.5cm" svg:width="4cm" svg:height="3cm"/>
  <draw:line draw:style-name="line" svg:x1="6cm" svg:y1="8.5cm" svg:x2="10cm" svg:y2="5.5cm"/>
  <draw:frame draw:style-name="boxfill" svg:x="11cm" svg:y="5.5cm" svg:width="4cm" svg:height="3cm"><draw:text-box><text:p>Text box</text:p></draw:text-box></draw:frame>
  <draw:frame draw:style-name="boxnone" svg:x="16cm" svg:y="5.5cm" svg:width="4cm" svg:height="3cm"><draw:text-box><text:p>No fill</text:p></draw:text-box></draw:frame>
  <draw:frame draw:style-name="boxhatch" svg:x="1cm" svg:y="10cm" svg:width="4cm" svg:height="3cm"><draw:text-box><text:p>Hatch</text:p></draw:text-box></draw:frame>
  <draw:g draw:style-name="group"><draw:rect draw:style-name="plain" svg:x="6cm" svg:y="10cm" svg:width="4cm" svg:height="3cm"/><draw:rect draw:style-name="solid" svg:x="11cm" svg:y="10cm" svg:width="4cm" svg:height="3cm"/></draw:g>
 </draw:page></office:drawing></office:body>
</office:document>
