<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:meta="urn:oasis:names:tc:opendocument:xmlns:meta:1.0" xmlns:number="urn:oasis:names:tc:opendocument:xmlns:datastyle:1.0" xmlns:presentation="urn:oasis:names:tc:opendocument:xmlns:presentation:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:loext="urn:org:documentfoundation:names:experimental:office:xmlns:loext:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.graphics">
<office:styles><style:style style:name="gr1" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#b4c7dc" draw:stroke="solid" svg:stroke-color="#3465a4" svg:stroke-width="0.05cm"/></style:style></office:styles>
<office:master-styles><style:master-page style:name="Standard"/></office:master-styles>
<office:body><office:drawing>
<draw:page draw:name="page1" draw:master-page-name="Standard"><draw:rect draw:style-name="gr1" svg:x="2cm" svg:y="2cm" svg:width="10cm" svg:height="4cm"><text:p>Page 1</text:p></draw:rect></draw:page>
<draw:page draw:name="page2" draw:master-page-name="Standard"><draw:rect draw:style-name="gr1" svg:x="3cm" svg:y="3cm" svg:width="10cm" svg:height="4cm"><text:p>Page 2</text:p></draw:rect></draw:page>
<draw:page draw:name="page3" draw:master-page-name="Standard"><draw:rect draw:style-name="gr1" svg:x="4cm" svg:y="4cm" svg:width="10cm" svg:height="4cm"><text:p>Page 3</text:p></draw:rect></draw:page>
</office:drawing></office:body></office:document>
