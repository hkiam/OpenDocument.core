<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:meta="urn:oasis:names:tc:opendocument:xmlns:meta:1.0" xmlns:number="urn:oasis:names:tc:opendocument:xmlns:datastyle:1.0" xmlns:presentation="urn:oasis:names:tc:opendocument:xmlns:presentation:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:loext="urn:org:documentfoundation:names:experimental:office:xmlns:loext:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.graphics">
<office:font-face-decls><style:font-face style:name="Liberation Sans" svg:font-family="&apos;Liberation Sans&apos;" style:font-family-generic="swiss"/></office:font-face-decls>
<office:styles>
<draw:gradient draw:name="G1" draw:style="linear" draw:start-color="#ffffff" draw:end-color="#2a6099" draw:start-intensity="100%" draw:end-intensity="100%" draw:angle="30deg" draw:border="0%"/>
<draw:hatch draw:name="H1" draw:style="double" draw:color="#c9211e" draw:distance="0.15cm" draw:rotation="450"/>
</office:styles>
<office:automatic-styles>
<style:page-layout style:name="PM1"><style:page-layout-properties fo:margin-top="0cm" fo:margin-bottom="0cm" fo:margin-left="0cm" fo:margin-right="0cm" fo:page-width="21cm" fo:page-height="9cm" style:print-orientation="landscape"/></style:page-layout>
<style:style style:name="shadow" style:family="graphic"><style:graphic-properties draw:stroke="solid" svg:stroke-color="#000000" svg:stroke-width="0.03cm" draw:fill="solid" draw:fill-color="#ffd320" draw:shadow="visible" draw:shadow-offset-x="0.3cm" draw:shadow-offset-y="0.3cm" draw:shadow-color="#000000" draw:shadow-opacity="50%"/><style:paragraph-properties fo:text-align="center"/><style:text-properties fo:font-size="12pt" style:font-name="Liberation Sans"/></style:style>
<style:style style:name="nofill" style:family="graphic"><style:graphic-properties draw:stroke="solid" svg:stroke-color="#000000" svg:stroke-width="0.03cm"/><style:paragraph-properties fo:text-align="center"/><style:text-properties fo:font-size="12pt" style:font-name="Liberation Sans"/></style:style>
<style:style style:name="gradshadow" style:family="graphic"><style:graphic-properties draw:stroke="solid" svg:stroke-color="#000000" svg:stroke-width="0.03cm" draw:fill="gradient" draw:fill-gradient-name="G1" draw:shadow="visible" draw:shadow-offset-x="0.25cm" draw:shadow-offset-y="0.25cm" draw:shadow-color="#7f7f7f" loext:shadow-blur="0.2cm"/><style:paragraph-properties fo:text-align="center"/><style:text-properties fo:font-size="12pt" style:font-name="Liberation Sans"/></style:style>
<style:style style:name="hatch" style:family="graphic"><style:graphic-properties draw:stroke="solid" svg:stroke-color="#000000" svg:stroke-width="0.03cm" draw:fill="hatch" draw:fill-hatch-name="H1" draw:fill-hatch-solid="true" draw:fill-color="#fff5ce"/><style:paragraph-properties fo:text-align="center"/><style:text-properties fo:font-size="12pt" style:font-name="Liberation Sans"/></style:style>
</office:automatic-styles>
<office:master-styles><style:master-page style:name="Standard" style:page-layout-name="PM1"/></office:master-styles>
<office:body><office:drawing>
<draw:page draw:name="page1" draw:master-page-name="Standard">
<draw:rect draw:style-name="shadow" svg:x="1cm" svg:y="1.5cm" svg:width="4cm" svg:height="3cm"><text:p>shadow</text:p></draw:rect>
<draw:ellipse draw:style-name="nofill" svg:x="6cm" svg:y="1.5cm" svg:width="4cm" svg:height="3cm"><text:p>no fill stated</text:p></draw:ellipse>
<draw:rect draw:style-name="gradshadow" svg:x="11cm" svg:y="1.5cm" svg:width="4cm" svg:height="3cm"><text:p>gradient, blur</text:p></draw:rect>
<draw:ellipse draw:style-name="hatch" svg:x="16cm" svg:y="1.5cm" svg:width="4cm" svg:height="3cm"><text:p>hatch</text:p></draw:ellipse>
</draw:page>
</office:drawing></office:body></office:document>
